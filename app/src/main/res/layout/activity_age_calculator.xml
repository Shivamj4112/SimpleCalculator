<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clActionBar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:padding="6dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            style="@style/ScreenTitle"
            android:text="@string/age"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActions"
        app:layout_constraintTop_toBottomOf="@id/clActionBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="5dp">

            <!-- DOB and Today Cards -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDob"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/keypad_number_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/date_of_birth"
                        android:textColor="@color/text_color"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tvDobValue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvDobValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="center_vertical"
                        android:textColor="@color/sub_text_color"
                        android:textSize="15sp"
                        app:drawableEndCompat="@drawable/ic_arrow_down"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/textView2"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Jan 27, 2026" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardToday"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/keypad_number_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/cardDob">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/today"
                        android:textColor="@color/text_color"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tvTodayValue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvTodayValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="center_vertical"
                        android:textColor="@color/sub_text_color"
                        android:textSize="15sp"
                        app:drawableEndCompat="@drawable/ic_arrow_down"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/textView"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Jan 27, 2026" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvBirthDayResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/keypad_number_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/cardToday"
                app:strokeColor="@color/age_calculator_stroke_color"
                app:strokeWidth="0.6dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/linearLayout"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/view"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/textView3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:fontFamily="@font/inter_medium"
                                android:text="@string/age"
                                android:textColor="@color/text_color"
                                android:textSize="20sp"
                                app:layout_constraintBottom_toTopOf="@+id/linearLayout3"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/linearLayout3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="16dp"
                                app:layout_constraintBottom_toTopOf="@+id/tvMonthsDays"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/textView3">

                                <TextView
                                    android:id="@+id/tvYearsNumber"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:textColor="@color/primaryColor"
                                    android:fontFamily="@font/inter_medium"
                                    android:textSize="50sp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toStartOf="@+id/tvYearMonth"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    tools:text="24" />

                                <TextView
                                    android:id="@+id/tvYearMonth"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_marginBottom="7dp"
                                    android:fontFamily="@font/inter_regular"
                                    android:text="@string/years"
                                    android:textColor="@color/text_color"
                                    android:textSize="20sp"
                                    app:layout_constraintBottom_toBottomOf="@+id/tvYearsNumber"
                                    app:layout_constraintStart_toEndOf="@+id/tvYearsNumber" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <TextView
                                android:id="@+id/tvMonthsDays"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingExtra="10dp"
                                android:textAlignment="center"
                                android:fontFamily="@font/inter_regular"
                                android:textColor="@color/age_calculator_stroke_color"
                                android:textSize="18sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/linearLayout3"
                                tools:targetApi="28"
                                tools:text="3 Month\n5 Day" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <View
                            android:id="@+id/view"
                            android:layout_width="0.6dp"
                            android:layout_height="0dp"
                            android:background="@color/age_calculator_stroke_color"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/linearLayout2"
                            app:layout_constraintStart_toEndOf="@+id/linearLayout"
                            app:layout_constraintTop_toTopOf="parent" />


                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/linearLayout2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/view"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/textView4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginTop="20dp"
                                android:fontFamily="@font/inter_medium"
                                android:text="@string/next_birthday"
                                android:textColor="@color/text_color"
                                android:textSize="20sp"
                                app:layout_constraintBottom_toTopOf="@+id/imageView"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/imageView"
                                android:layout_width="110dp"
                                android:layout_height="90dp"
                                android:layout_marginTop="5dp"
                                android:padding="3dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_cake"
                                app:layout_constraintBottom_toTopOf="@+id/tvNextBirthdayDay"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/textView4" />

                            <TextView
                                android:id="@+id/tvNextBirthdayDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/inter_regular"
                                android:textColor="@color/age_calculator_stroke_color"
                                android:textSize="19sp"
                                app:layout_constraintBottom_toTopOf="@+id/tvNextBirthdayCountdown"
                                app:layout_constraintEnd_toEndOf="@+id/imageView"
                                app:layout_constraintStart_toStartOf="@+id/imageView"
                                app:layout_constraintTop_toBottomOf="@+id/imageView"
                                tools:text="Thursday" />

                            <TextView
                                android:id="@+id/tvNextBirthdayCountdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/inter_regular"
                                android:gravity="center"
                                android:lineSpacingExtra="5dp"
                                android:textColor="@color/age_calculator_stroke_color"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvNextBirthdayDay"
                                tools:targetApi="28"
                                tools:text="8 Months\n25 Day" />
                        </androidx.constraintlayout.widget.ConstraintLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.6dp"
                        android:background="@color/age_calculator_stroke_color"
                        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
                        app:layout_constraintTop_toBottomOf="@+id/header" />

                    <LinearLayout
                        android:id="@+id/bottomBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="15dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/summary"
                            android:textColor="@color/text_color"
                            android:textSize="18sp" />

                        <!-- Summary Table -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="5dp"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/linearLayout6"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/linearLayout5"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/years"
                                    android:fontFamily="@font/inter_medium"
                                    android:textColor="@color/text_color"
                                    android:textSize="17sp" />

                                <TextView
                                    android:id="@+id/tvSumYears"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="24"
                                    android:textSize="18sp"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="@font/inter_medium"
                                    android:textColor="@color/text_color" />

                                <TextView
                                    android:id="@+id/tvSumDaysFull"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:lineSpacingExtra="2dp"
                                    tools:text="Days\n8903"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/inter_regular"
                                    android:layout_marginTop="8dp"
                                    android:textColor="@color/age_calculator_stroke_color"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/linearLayout5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:gravity="center"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/linearLayout4"
                                app:layout_constraintStart_toEndOf="@+id/linearLayout6"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/months"
                                    android:fontFamily="@font/inter_medium"
                                    android:textColor="@color/text_color"
                                    android:textSize="17sp" />

                                <TextView
                                    android:id="@+id/tvSumMonths"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="291"
                                    android:textSize="18sp"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="@font/inter_medium"
                                    android:textColor="@color/text_color"/>

                                <TextView
                                    android:id="@+id/tvSumHours"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:lineSpacingExtra="2dp"
                                    tools:text="Hours\n213672"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:fontFamily="@font/inter_regular"
                                    android:layout_marginTop="8dp"
                                    android:textColor="@color/age_calculator_stroke_color"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/linearLayout4"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="1dp"
                                android:gravity="center"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/linearLayout5"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/weeks"
                                    android:fontFamily="@font/inter_medium"
                                    android:textColor="@color/text_color"
                                    android:textSize="17sp" />

                                <TextView
                                    android:id="@+id/tvSumWeeks"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="1266"
                                    android:textSize="18sp"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="@font/inter_medium"
                                    android:textColor="@color/text_color" />

                                <TextView
                                    android:id="@+id/tvSumMinutes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:lineSpacingExtra="2dp"
                                    tools:text="Minutes\n12782720"
                                    android:fontFamily="@font/inter_regular"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:layout_marginTop="8dp"
                                    android:textColor="@color/age_calculator_stroke_color"
                                    android:textSize="13sp" />
                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:paddingHorizontal="15dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCalendar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/light_grey"
            android:fontFamily="@font/inter_medium"
            android:text="@string/add_to_calendar"
            android:textAllCaps="false"
            android:textColor="@color/text_color"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnShare"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primaryColor"
            android:fontFamily="@font/inter_medium"
            android:text="@string/share"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnAddCalendar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnAddCalendar"
            app:layout_constraintTop_toTopOf="@+id/btnAddCalendar" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
