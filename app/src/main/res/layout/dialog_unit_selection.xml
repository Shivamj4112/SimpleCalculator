<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_dialog">

    <TextView
        android:id="@+id/tvSelectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter_semibold"
        android:text="@string/weight"
        android:textColor="@color/text_color"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/btnCloseSelection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnCloseSelection"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/ic_close_picker"
        app:layout_constraintBottom_toBottomOf="@+id/tvSelectionTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvSelectionTitle" />

    <LinearLayout
        android:id="@+id/optionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginVertical="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvSelectionTitle">

        <LinearLayout
            android:id="@+id/option1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivOption1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="2dp"
                android:src="@drawable/ic_unchecked"
                android:clickable="false"
                android:focusable="false"/>

            <TextView
                android:id="@+id/tvOption1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kilograms"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/text_color"
                android:textSize="16sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/option2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivOption2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="2dp"
                android:src="@drawable/ic_unchecked"
                android:clickable="false"
                android:focusable="false"/>

            <TextView
                android:id="@+id/tvOption2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pounds"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/text_color"
                android:textSize="16sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
