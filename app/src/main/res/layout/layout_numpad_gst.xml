<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    android:padding="16dp">

    <!-- MAIN KEYPAD -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMainPad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/clSideKeys"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ROW 7 8 9 -->
        <FrameLayout
            android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn8"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_button_bg"
                />

            <TextView
                style="@style/keypadBgStyle"
                android:text="@string/_7"
                android:layout_gravity="center"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btn7"
            app:layout_constraintEnd_toStartOf="@id/btn9"
            app:layout_constraintTop_toTopOf="@id/btn7">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_button_bg"
                />

            <TextView
                style="@style/keypadBgStyle"
                android:text="@string/_8"
                android:layout_gravity="center"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginStart="8dp"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btn8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn7">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_button_bg"
                />

            <TextView
                style="@style/keypadBgStyle"
                android:text="9"
                android:layout_gravity="center"/>
        </FrameLayout>

        <!-- ROW 4 5 6 -->
        <FrameLayout
            android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn5"
            app:layout_constraintTop_toBottomOf="@id/btn7">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_button_bg"
                />

            <TextView
                style="@style/keypadBgStyle"
                android:text="@string/_4"
                android:layout_gravity="center"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn4"
            app:layout_constraintEnd_toStartOf="@id/btn6"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btn4"
            app:layout_constraintTop_toTopOf="@id/btn4">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                
                android:src="@drawable/ic_button_bg" />

            <TextView
                style="@style/keypadBgStyle"
                android:layout_gravity="center"
                android:text="@string/_5" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btn5"
            app:layout_constraintTop_toTopOf="@id/btn4">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                
                android:src="@drawable/ic_button_bg" />

            <TextView
                style="@style/keypadBgStyle"
                android:layout_gravity="center"
                android:text="@string/_6" />
        </FrameLayout>

        <!-- ROW 1 2 3 -->
        <FrameLayout
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn2"
            app:layout_constraintTop_toBottomOf="@id/btn4">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_button_bg"
                />

            <TextView
                style="@style/keypadBgStyle"
                android:text="@string/_1"
                android:layout_gravity="center"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn1"
            app:layout_constraintEnd_toStartOf="@id/btn3"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btn1"
            app:layout_constraintTop_toTopOf="@id/btn1">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                
                android:src="@drawable/ic_button_bg" />

            <TextView
                style="@style/keypadBgStyle"
                android:layout_gravity="center"
                android:text="@string/_2" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btn2"
            app:layout_constraintTop_toTopOf="@id/btn1">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                
                android:src="@drawable/ic_button_bg" />

            <TextView
                style="@style/keypadBgStyle"
                android:layout_gravity="center"
                android:text="@string/_3" />
        </FrameLayout>

        <!-- ROW 0 . -->
        <FrameLayout
            android:id="@+id/btn0"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@id/btnDot"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintEnd_toEndOf="@id/btn2"
            app:layout_constraintStart_toStartOf="@+id/btn2"
            app:layout_constraintTop_toBottomOf="@id/btn2">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_button_bg" />

            <TextView
                style="@style/keypadBgStyle"
                android:layout_gravity="center"
                android:text="@string/_0" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnDot"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btn0"
            app:layout_constraintTop_toTopOf="@id/btn0">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                
                android:src="@drawable/ic_button_bg" />

            <TextView
                style="@style/keypadBgStyle"
                android:layout_gravity="center"
                android:text="@string/dot" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SIDE KEYS -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clSideKeys"
        android:layout_width="65dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@id/clMainPad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/clMainPad"
        app:layout_constraintTop_toTopOf="@id/clMainPad">

        <FrameLayout
            android:id="@+id/btnAC"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@id/btnDel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintVertical_weight="1">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                
                android:src="@drawable/ic_side_key_bg" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ac" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnDel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnAC"
            app:layout_constraintVertical_weight="1">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                
                android:src="@drawable/ic_side_key_bg" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_backspace" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>