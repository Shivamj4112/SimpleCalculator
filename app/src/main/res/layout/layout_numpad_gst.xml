<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="#F8F9FA">

    <LinearLayout
        android:id="@+id/mainKeys"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sideKeys"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btn7" style="@style/CalcButton.Number" android:layout_weight="1" android:text="7" />
            <Button android:id="@+id/btn8" style="@style/CalcButton.Number" android:layout_weight="1" android:text="8" />
            <Button android:id="@+id/btn9" style="@style/CalcButton.Number" android:layout_weight="1" android:text="9" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btn4" style="@style/CalcButton.Number" android:layout_weight="1" android:text="4" />
            <Button android:id="@+id/btn5" style="@style/CalcButton.Number" android:layout_weight="1" android:text="5" />
            <Button android:id="@+id/btn6" style="@style/CalcButton.Number" android:layout_weight="1" android:text="6" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btn1" style="@style/CalcButton.Number" android:layout_weight="1" android:text="1" />
            <Button android:id="@+id/btn2" style="@style/CalcButton.Number" android:layout_weight="1" android:text="2" />
            <Button android:id="@+id/btn3" style="@style/CalcButton.Number" android:layout_weight="1" android:text="3" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            <Button android:id="@+id/btn0" style="@style/CalcButton.Number" android:layout_weight="1" android:text="0" />
            <Button android:id="@+id/btnDot" style="@style/CalcButton.Number" android:layout_weight="1" android:text="." />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sideKeys"
        android:layout_width="100dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnAC"
            style="@style/CalcButton.Function"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="AC" />

        <Button
            android:id="@+id/btnDel"
            style="@style/CalcButton.Function"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_backspace"
            android:paddingStart="38dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
