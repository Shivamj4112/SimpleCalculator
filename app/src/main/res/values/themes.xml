<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SimpleCalculator" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:includeFontPadding">false</item>

    </style>

    <style name="Theme.SimpleCalculator" parent="Base.Theme.SimpleCalculator" />

    <style name="CalcButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">75dp</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_result</item>
        <item name="android:textSize">24sp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="CalcButton.Number" parent="CalcButton">
        <item name="backgroundTint">@color/btn_number</item>
    </style>

    <style name="CalcButton.Function" parent="CalcButton">
        <item name="backgroundTint">@color/btn_function</item>
    </style>

    <style name="CalcButton.Equals" parent="CalcButton">
        <item name="backgroundTint">@color/primaryColor</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SingleLineStyle" parent="Widget.AppCompat.TextView">
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>


    <style name="keypadBgStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ScreenTitle" parent="SingleLineStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:layout_marginHorizontal">10dp</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="NavigateBackStyle">
        <item name="android:src">@drawable/ic_back</item>
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="UnitConverterIcon">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="UnitConverterText" parent="SingleLineStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginHorizontal">6dp</item>
        <item name="android:textColor">@color/unit_converter_icon_color</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="GstRateButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#333</item>
        <item name="backgroundTint">#F0F0F0</item>
        <item name="cornerRadius">8dp</item>
    </style>

</resources>